{
  "codkitConventions": 1,
  "subsystems": [
    "workbench",
    "editor",
    "platform",
    "extensions",
    "build",
    "product",
    "base",
    "server",
    "test"
  ],
  "idPattern": "^CK-(workbench|editor|platform|extensions|build|product|base|server|test)-[0-9]{3}$",
  "interventionTypes": ["extend", "modify", "disable", "hook"],
  "categories": ["own", "follow", "hide"],
  "layers": [
    "own",
    "service-override",
    "entry-module",
    "config-overlay",
    "resource-file",
    "rewrite-rule",
    "patch"
  ],
  "markerComment": {
    "_doc": "Marker forms by file extension (PROP-004 section 1). Every key except this one is a file extension; the value is {open, close}: the marker line is <indent><open>begin <ID><close> and <indent><open>end <ID><close>. For line-comment languages close is the empty string. Keys starting with an underscore are documentation and are never matched against an extension.",
    ".ts": { "open": "// codkit:", "close": "" },
    ".js": { "open": "// codkit:", "close": "" },
    ".mjs": { "open": "// codkit:", "close": "" },
    ".cjs": { "open": "// codkit:", "close": "" },
    ".jsonc": { "open": "// codkit:", "close": "" },
    ".css": { "open": "/* codkit:", "close": " */" },
    ".html": { "open": "<!-- codkit:", "close": " -->" },
    ".md": { "open": "<!-- codkit:", "close": " -->" },
    ".svg": { "open": "<!-- codkit:", "close": " -->" },
    ".sh": { "open": "# codkit:", "close": "" },
    ".ps1": { "open": "# codkit:", "close": "" },
    ".yml": { "open": "# codkit:", "close": "" },
    ".yaml": { "open": "# codkit:", "close": "" }
  },
  "forbiddenPatchTargets": [".config/1espt/**"],
  "forbiddenServiceIds": [
    "IAccountPolicyGateService",
    "IBrowserWorkbenchEnvironmentService",
    "IDefaultAccountService",
    "IEncryptionService",
    "IFileManagedSettingsService",
    "IFileService",
    "ILogService",
    "ILoggerService",
    "IMainProcessService",
    "IManagedSettingsService",
    "INativeKeyboardLayoutService",
    "INativeManagedSettingsService",
    "INativeWorkbenchEnvironmentService",
    "IPolicyService",
    "IProductService",
    "IRemoteAgentService",
    "IRemoteAuthorityResolverService",
    "IRemoteSocketFactoryService",
    "IRequestService",
    "ISecretStorageService",
    "ISharedProcessService",
    "ISignService",
    "IStorageService",
    "IUriIdentityService",
    "IUserDataInitializationService",
    "IUserDataProfileService",
    "IUserDataProfilesService",
    "IUserDataSyncStoreManagementService",
    "IUtilityProcessWorkerWorkbenchService",
    "IWorkbenchConfigurationService",
    "IWorkbenchLayoutService",
    "IWorkspaceContextService",
    "IWorkspaceTrustEnablementService",
    "IWorkspaceTrustManagementService"
  ],
  "cleanupWhitelist": [
    "node_modules/",
    ".build/",
    "/out*/",
    "extensions/*/out/",
    "extensions/*/dist/",
    ".eslintcache",
    "*.tsbuildinfo"
  ]
}
